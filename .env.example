MY_ATLASSIAN_TOKEN=
JIRA_SITE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com

# Desktop app OAuth client, used by scripts/google-calendar-auth.js +
# scripts/google-calendar-ingest.js (Node only, has a real secret)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Web application OAuth client, used by src/ui/ConnectCalendar.jsx in the
# browser. VITE_-prefixed vars are exposed to client code by Vite — this is
# a public client ID (no secret), safe to ship in the bundle.
VITE_GOOGLE_CALENDAR_WEB_CLIENT_ID=
